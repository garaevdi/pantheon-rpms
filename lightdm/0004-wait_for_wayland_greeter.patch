 src/seat-local.c                              | 65 ++++++++++++++++---
 tests/Makefile.am                             |  8 +++
 tests/scripts/wayland-plymouth-autologin.conf | 23 +++++++
 .../scripts/wayland-plymouth-fail-start.conf  | 19 ++++++
 tests/scripts/wayland-plymouth-timeout.conf   | 23 +++++++
 tests/scripts/wayland-plymouth.conf           | 19 ++++++
 tests/src/test-gobject-greeter.c              |  7 +-
 tests/test-wayland-plymouth                   |  2 +
 tests/test-wayland-plymouth-autologin         |  2 +
 tests/test-wayland-plymouth-fail-start        |  2 +
 tests/test-wayland-plymouth-timeout           |  2 +
 11 files changed, 161 insertions(+), 11 deletions(-)
 create mode 100644 tests/scripts/wayland-plymouth-autologin.conf
 create mode 100644 tests/scripts/wayland-plymouth-fail-start.conf
 create mode 100644 tests/scripts/wayland-plymouth-timeout.conf
 create mode 100644 tests/scripts/wayland-plymouth.conf
 create mode 100755 tests/test-wayland-plymouth
