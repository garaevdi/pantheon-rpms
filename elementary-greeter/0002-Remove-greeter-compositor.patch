-        if (key == "sources" || key == "xkb-options" || key == "current") {
-#else
-        if (key == "sources" || key == "xkb-options") {
-#endif
-            string[] layouts = {}, variants = {};
-
-            var sources = settings.get_value ("sources");
-            if (!sources.is_of_type (sources_variant_type)) {
-                return;
-            }
