-        uint left;
-        uint right;
-        uint top;
-        uint bottom;
-        uint clip_radius;
-    }
-
-    private const int BLUR_RADIUS = 12;
-
-    private static BlurManager instance;
-
-    public static void init (WindowManager wm) {
-        if (instance != null) {
-            return;
-        }
-
-        instance = new BlurManager (wm);
